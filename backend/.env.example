# ---------------------------------------------------------------------------
# LLM provider — OpenRouter (https://openrouter.ai/keys)
# ---------------------------------------------------------------------------
# One key, ~300 models across Meta, OpenAI, Moonshot, DeepSeek, Qwen, Google,
# Mistral and others. The API is OpenAI-compatible, so the app uses the openai
# SDK with a different base_url.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Only change this if you are proxying OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback model when a request does not name one. Must satisfy the curation
# rules below (or be listed in MODEL_ALLOWLIST), otherwise requests are refused
# with a clear error instead of silently falling back.
DEFAULT_MODEL=openai/gpt-oss-20b

# Run the whole app offline with canned completions. No credits are spent.
USE_FAKE_LLM=false

# ---------------------------------------------------------------------------
# Model catalog curation
# ---------------------------------------------------------------------------
# The dropdown is built from OpenRouter's live catalog, filtered by these rules.
# No model names are stored in code — only the rules that select them. When a
# provider retires a model it disappears from the list on the next refresh.

# Budget guard. OpenRouter carries models at $15+/M tokens; this is a public
# demo, so anything pricier is never offered and never accepted.
MODEL_MAX_PROMPT_PRICE=1.00
MODEL_MAX_COMPLETION_PRICE=3.00

# Capability floor.
MODEL_MIN_CONTEXT=32000

# How many models to show per vendor.
MODEL_MAX_PER_VENDOR=3

# Which labs to offer, comma-separated. Vendors are pinned instead of models
# because company names are stable while model IDs are not. OpenRouter carries
# ~48 vendors under the price ceiling above -- most of them niche roleplay or
# coding-assistant shops -- so without this the dropdown runs past 100 entries.
# Leave this line out entirely to use the built-in default set of major labs.
# Set it to empty to allow every vendor, bounded by MODEL_MAX_VENDORS.
MODEL_VENDORS=openai,anthropic,google,meta,meta-llama,mistralai,deepseek,qwen,moonshotai,x-ai,microsoft,amazon,cohere,nvidia

# Only used when MODEL_VENDORS is empty: keeps the best-represented vendors.
MODEL_MAX_VENDORS=12

# Substrings that disqualify a model ID. These pass every numeric filter but
# misbehave in a synchronous chat app:
#   :batch      asynchronous batch endpoints — never return a completion inline
#   -safety     content classifiers that emit verdicts instead of answers
#   -guard      same
# Models whose output is not text-only (image or audio generators) are excluded
# automatically and need no pattern here.
MODEL_EXCLUDE_PATTERNS=:batch,-safety,-guard,guardrail,moderation

# Seconds before the catalog is re-fetched.
MODEL_CATALOG_TTL=3600

# Comma-separated model IDs that always appear, regardless of the rules above.
# Use this to pin a favourite that the price ceiling would otherwise exclude.
MODEL_ALLOWLIST=

# ---------------------------------------------------------------------------
# Generation defaults
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Shown on your OpenRouter dashboard for traffic attribution.
APP_TITLE=AI Knowledge Search
APP_PUBLIC_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Chunking is pure text splitting and never touches a model or an API. Only the
# embedding step (chunk -> vector) can be remote.
#
# Seven models run locally from downloaded weights: free, private, no network,
# but they hold RAM and slow startup. API embedding models come from the same
# live OpenRouter catalog as the chat models and are listed alongside them.
#
# Price ceiling for API embedding models, $ per million input tokens.
# Embeddings are far cheaper than chat, hence the much lower default.
EMBEDDING_MAX_PRICE=0.20

# Default embedding model. Local models are referenced by bare name; API models
# use their full OpenRouter ID (e.g. openai/text-embedding-3-small).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

